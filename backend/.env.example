PORT=3000
DATABASE_URL=postgres://nirva:nirva@localhost:5432/nirvaprocure
JWT_SECRET=replace-me-in-prod

# Google OAuth (optional). Get a Client ID from console.cloud.google.com.
GOOGLE_OAUTH_CLIENT_ID=
# Comma-separated email domains that may sign in via Google. Leave empty to allow any.
GOOGLE_OAUTH_ALLOWED_DOMAINS=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret — used to verify HMAC-SHA256 X-Line-Signature on webhooks.
LINE_CHANNEL_SECRET=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (SMTP). Leave SMTP_HOST empty to disable (logs instead of sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME=NIRVAPROCURE
FROM_EMAIL=noreply@nirvaprocure.local

# Audit log archive (S3-compatible). Leave AUDIT_ARCHIVE_BUCKET empty to skip.
AUDIT_ARCHIVE_BUCKET=
AUDIT_ARCHIVE_REGION=ap-southeast-1
# Set this only for MinIO/R2; leave empty for real AWS.
AUDIT_ARCHIVE_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
