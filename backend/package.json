  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^12.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.3.3"
