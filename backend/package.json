      "**/*.spec.ts"
    ],
    "rootDir": "src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.6",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^10.0.16",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
