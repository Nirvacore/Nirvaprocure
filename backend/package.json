    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^11.1.24",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
