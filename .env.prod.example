# Production env for docker-compose.prod.yml / scripts/vps-setup.sh
# Copy:  cp .env.prod.example .env && edit values

# --- required ---
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
JWT_SECRET=change-me-use-openssl-rand-hex-48

# Public URLs (must match Caddy / DNS)
# IP-only example:
#   WEB_ORIGIN=http://62.146.233.240
#   NEXT_PUBLIC_API_BASE_URL=http://62.146.233.240:3000/v1
# Domain + HTTPS example:
#   WEB_ORIGIN=https://nirvaprocure.com
#   NEXT_PUBLIC_API_BASE_URL=https://api.nirvaprocure.com/v1
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/v1

# --- optional: Caddy automatic HTTPS (profile `ssl`) ---
DOMAIN=
ACME_EMAIL=

# --- optional integrations ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
